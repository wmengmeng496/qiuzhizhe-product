PORT=8787
NODE_ENV=production
APP_RELEASE=replace-with-release-id
PUBLIC_URL=https://www.qiuzhijianli.xyz
CORS_ORIGIN=https://www.qiuzhijianli.xyz

DATABASE_URL=postgres://user:password@database-host:5432/job_assistant
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-long-random-admin-token

SMS_REQUIRED=true
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-ram-user-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-ram-user-access-key-secret
ALIBABA_CLOUD_SMS_SIGN_NAME=北京栩寻科技
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=SMS_337360301
ALIBABA_CLOUD_SMS_ENDPOINT=dysmsapi.aliyuncs.com

TOAPIS_BASE_URL=https://toapis.com/v1
TOAPIS_API_KEY=replace-with-your-toapis-api-key
AI_DEFAULT_MODEL=gpt-5.6-sol
AI_OCR_MODEL=gpt-6-astra
AI_OCR_FALLBACK_MODELS=gpt-4o
AI_FALLBACK_MODELS=gpt-5.5,gpt-4o
AI_TIMEOUT_MS=150000
AI_RESUME_TIMEOUT_MS=300000
