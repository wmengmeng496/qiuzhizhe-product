PORT=8787
NODE_ENV=production
APP_RELEASE=replace-with-release-id
PUBLIC_URL=https://www.qiuzhijianli.xyz
CORS_ORIGIN=https://www.qiuzhijianli.xyz

DATABASE_URL=postgres://user:password@database-host:5432/job_assistant
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-long-random-admin-token

TOAPIS_BASE_URL=https://toapis.com/v1
TOAPIS_API_KEY=replace-with-your-toapis-api-key
AI_DEFAULT_MODEL=gpt-5.6-sol
AI_OCR_MODEL=gpt-5.6-sol
AI_FALLBACK_MODELS=gpt-5.5,gpt-4o
AI_TIMEOUT_MS=45000
